# Server-only configuration. Copy to supabase/.env.local for local serving.
# RSVP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: a Supabase secret key (sb_secret_...). Local: CLI service_role key.
RSVP_DATABASE_KEY=REPLACE_WITH_SERVER_ONLY_KEY
# SUPABASE_URL is supplied by the Edge Function runtime.

# Optional admin alerts. Server-only; leave blank to skip sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
